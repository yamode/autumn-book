# データソース切替: demo（インメモリ・既定） / supabase（book スキーマ適用後に切替）
DATA_SOURCE=demo

# Supabase「Autumn Platform」(opkocyapzmsjzhbwlguh・東京)
PUBLIC_SUPABASE_URL=https://opkocyapzmsjzhbwlguh.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# メンテナンスモード（正式公開前・メンテ作業中に一般非公開）
# on で強制有効（管理画面トグルでは解除不可）/ 既定 off。本番は Cloudflare Pages の環境変数で設定
MAINTENANCE_MODE=off
# 任意: プレビュー共有用トークン（?preview=<token> でバイパス→cookie 発行）。未設定なら運営ログインのみバイパス
MAINTENANCE_BYPASS_TOKEN=
# 任意: メンテナンスページ本文の差し替え（未設定なら既定文言）
MAINTENANCE_MESSAGE=
