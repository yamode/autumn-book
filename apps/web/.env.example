# データソース切替: demo（インメモリ・既定） / supabase（book スキーマ適用後に切替）
# supabase: ニュース・コミュニティ読み取りが PROD 実データ（コミュニティ書き込みは P5 まで不可＝アプリ誘導）
DATA_SOURCE=demo

# 管理者認証: demo（ワンクリック・移行前の既定） / supabase（Supabase Auth・email+パスワード）
# supabase にする前に: Email プロバイダ有効化・Redirect URL 登録・管理者ユーザー作成（app_metadata.role=admin）が必要
AUTH_MODE=demo

# Supabase「Autumn Platform」(opkocyapzmsjzhbwlguh・東京)
PUBLIC_SUPABASE_URL=https://opkocyapzmsjzhbwlguh.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# メンテナンスモード（正式公開前・メンテ作業中に一般非公開）
# on で強制有効（管理画面トグルでは解除不可）/ 既定 off。本番は Cloudflare Pages の環境変数で設定
MAINTENANCE_MODE=off
# 任意: プレビュー共有用トークン（?preview=<token> でバイパス→cookie 発行）。未設定なら運営ログインのみバイパス
MAINTENANCE_BYPASS_TOKEN=
# 任意: メンテナンスページ本文の差し替え（未設定なら既定文言）
MAINTENANCE_MESSAGE=

# GA4 計測（設計書 §9）: 測定 ID（G-XXXXXXXXXX）を設定すると gtag + Consent Mode v2 バナーが有効化
# 未設定なら計測・バナーとも完全無効。本番は wrangler.jsonc の vars に設定（教訓: vars はダッシュボード env を置換）
PUBLIC_GA4_MEASUREMENT_ID=

# ── 取引先専用ページ（/p/<token>・autumn-rms から移設）──────────────────────
# 本番は Cloudflare Pages の「シークレット（暗号化）」で登録する（wrangler.jsonc の vars には書かない）。
#   例: npx wrangler pages secret put SUPABASE_SERVICE_ROLE_KEY --project-name autumn-book
# 未設定でも画面は落ちず「現在ご利用いただけません」（503）になる。
# service_role キー（取引先モジュール専用。Book の他の機能では使わない）
SUPABASE_SERVICE_ROLE_KEY=
# 任意（未設定なら PUBLIC_SUPABASE_URL を使う）
SUPABASE_URL=
# Stripe（取引先予約のオンライン決済）。未設定ならオンライン決済は画面に出ない
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 請求 cron（/api/cron/partner-charge）の Bearer
CRON_SECRET=
# 通知メール（Cloudflare Email Sending REST）。未設定なら送信しない
CF_ACCOUNT_ID=
CF_EMAIL_API_TOKEN=
REPORT_EMAIL_FROM=
# 取引先予約の添付ファイル（true / false・既定 false）。本番は wrangler.jsonc の vars（秘密ではない）。
# PMS が event 'attachments' に対応してから true にする（docs/partner-booking-attachments.md §12）
PARTNER_BOOKING_ATTACHMENTS=false
