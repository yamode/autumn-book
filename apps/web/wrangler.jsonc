{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "autumn-book",
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"compatibility_date": "2025-05-05",
	// Paraglide の server.js が async_hooks(AsyncLocalStorage) を動的 import するため必須
	"compatibility_flags": ["nodejs_compat"],
 "ai": { "binding": "AI" },
	// アプリ設定フラグ（メンテナンスモード等）を edge 間で共有する KV。
	// 管理画面トグルの保存先。本番では pages deploy がこのバインドを適用する。
	// AB_RATE: FAQ ボット公開 API のレート制限（設計書 autumn_book_faq_bot_design.md §5）。
	"kv_namespaces": [
		{ "binding": "AB_CONFIG", "id": "d03a529d29c649dc8401819089dbd155" },
		{ "binding": "AB_RATE", "id": "c2bf46d69f1d40fc99aa723d054f007f" }
	],
	// 本番（Pages）環境変数。pages deploy は config の vars でダッシュボード env を「置換」する
	// （additive ではない）ため、本番に必要な変数はすべてここに集約する（＝単一の源・再現性）。
	//  - AUTH_MODE=supabase：管理ログインを Supabase Auth に。ローカル dev は .env（既定 demo）が優先。
	//  - DATA_SOURCE=supabase：news機能をbook.news_posts実データに接続。ローカル dev は .env（既定 demo）が優先。
	//  - PUBLIC_SUPABASE_*：Supabase Auth クライアントが $env/dynamic/public 経由で使用（publishable=公開値）。
	// ⚠ 秘密（取引先専用ページ用の SUPABASE_SERVICE_ROLE_KEY / STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET /
	//   CRON_SECRET / CF_EMAIL_API_TOKEN / CLOUDFLARE_BROWSER_RENDERING_TOKEN）と、決済部品の公開可能キー
	//   PUBLIC_STRIPE_PUBLISHABLE_KEY（公開値だが Stripe のテスト/本番の切替をダッシュボードで行うため・v0.42.0）はここに書かない。
	//   `wrangler pages secret put <NAME> --project-name autumn-book`（暗号化シークレット）で登録する。
	//  - CF_ACCOUNT_ID：Cloudflare のアカウントID（秘密ではない）。メール送信（Email Sending）と請求書 PDF（Browser Rendering）の
	//    REST API で使う。2026-10-01 まで本番に未登録で、取引先向けメールが一度も送られていなかった（送信不可は黙ってスキップする作り）。
	//  - REPORT_EMAIL_FROM：差出人（yamado.app 配下。Email Sending 有効化済み）。
	//  - 事前チェックインの SMS（NTT CPaaS・P4）は secret で登録する（ここに値を書かない）:
	//    NTT_CPAAS_BASE_URL / NTT_CPAAS_API_KEY / NTT_CPAAS_SENDER / NTT_CPAAS_WEBHOOK_SECRET（Webhook の Basic 認証「ユーザー名:パスワード」）。
	//    どれか欠けると SMS は送らず「SMS未設定」になる（メールは送れる）。
	"vars": {
		// 事前チェックインの当日 9:00 の自動送信（/api/cron/precheckin-send）。'1' のときだけ送る。'0' は対象件数だけ数える dry-run
		"PRECHECKIN_AUTOSEND": "0",
		"CF_ACCOUNT_ID": "6aa45d1081c1e08d7f1ce6d5aba5c3b7",
		"REPORT_EMAIL_FROM": "rms@yamado.app",
		"AUTH_MODE": "supabase",
		"DATA_SOURCE": "supabase",
		// 西和賀問い合わせの受付。AI/IMAP接続と社内での一巡確認後に true にする。
		"INQUIRY_NISHIWAGA_ENABLED": "true",
		"PRIVATE_BATH_PMS_ENABLED": "true",
		"PUBLIC_GA4_MEASUREMENT_ID": "G-JFW5QS8QKH",
		"PUBLIC_SUPABASE_URL": "https://opkocyapzmsjzhbwlguh.supabase.co",
		"PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_5LrR74B4VdgRpq1koMbrQA_SIvpAWk0",
		// 取引先予約の添付ファイル（docs/partner-booking-attachments.md）。PMS の対応（event 'attachments'）を出してから true にする
		"PARTNER_BOOKING_ATTACHMENTS": "true",
		// 管理画面の二段階認証（TOTP）を全員に必須にするか（docs/auth-hardening.md §7.2・M7）。
		// false＝登録は任意（登録した人だけ毎回コードを求める）。必須化の日に true にする（Supabase で TOTP を有効化してから）
		"ADMIN_MFA_REQUIRED": "false",
		// Cloudflare Turnstile のサイトキー（公開値・docs/auth-hardening.md §4.2）。取引先ログイン／パスワード設定・管理ログイン・会員の認証コード送信に付ける。
		// 空なら部品を出さず、サーバも検証をスキップする。シークレット TURNSTILE_SECRET_KEY は
		// `wrangler pages secret put TURNSTILE_SECRET_KEY --project-name autumn-book` で登録する（両方そろったときだけ検証する）
		"PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFS1Q2-p9tAqczQX",
		// 取引先ページのパスキー（WebAuthn）の RP ID（docs/auth-hardening.md §6.5・S6）。このホスト名で開いたときだけパスキーを使える
		// （*.autumn-book.pages.dev のプレビューでは出さない）。ローカル（localhost）は設定なしで使える。空ならローカル以外は無効
		"PASSKEY_RP_ID": "book.yamado.app",
		// 旧 tripla マイページへの動線（docs/launch-tripla-cutover.md §3・§5）。リンク先が空なら /booking/lookup の「以前の予約システム」の段を出さない。
		// ★リンク先は未確定（要確認 Q2・hp-book-integration Q13）。候補: 西和賀 https://www.yamado.co.jp/?tripla_booking_widget_open=signIn ／ 男鹿 https://oga.yamado.co.jp/?tripla_booking_widget_open=signIn
		// 両施設同じなら LEGACY_MYPAGE_URL、施設別なら _NISHIWAGA／_OGA（施設別が優先）。
		"LEGACY_MYPAGE_URL": "",
		"LEGACY_MYPAGE_URL_NISHIWAGA": "",
		"LEGACY_MYPAGE_URL_OGA": "",
		// この日（日本時間）を過ぎたら「終了しました」に変わる。暫定 2027-08-31（最終チェックイン 2027-07-31 の約 1 か月後・★Q7 で見直し）
		"LEGACY_MYPAGE_UNTIL": "2027-08-31",
		// この日から文言が「以前の予約システム」になる（それまでは「現在の予約システム」）
		"BOOK_LAUNCH_DATE": "2026-12-01",
		// 受電端末（内線アプリ）の OS・アプリ更新の通知先（開発者・カンマ区切り）。/api/cron/intercom-device-notify が使う。未設定なら送らない（v0.215.0）
		"INTERCOM_ALERT_EMAIL": "dev@yamado.co.jp"
	}
}
